PAY_TO=0xYourKiteWalletAddress
KITE_NETWORK=testnet
UPSTREAM_URL=https://coins.llama.fi

# Tiered pricing (USD). DeFiLlama is free, so the split reflects value:
#   PRICE_USD          -> real-time price snapshot (cheap, standard)
#   PRICE_USD_PREMIUM  -> convert / portfolio / history (server-computed or
#                         larger payload, premium)
PRICE_USD=0.001
PRICE_USD_PREMIUM=0.01

# Per-client rate limit on paid calls (requests/min). 0 disables.
RATE_LIMIT_PER_MIN=10

SERVICE_DESCRIPTION=Crypto market data (DeFiLlama token prices, cross-conversion, portfolio valuation and history) for the Kite network
PORT=8080
